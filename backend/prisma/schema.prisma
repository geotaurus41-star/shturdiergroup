generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum DeliveryMethodType {
  COURIER
  PICKUP
  PRIORITY
}

enum PaymentProvider {
  MOCK
  TBC_PAY
  BOG
  PAYZE
  STRIPE
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTMENT
  EXPIRED
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum MaterialType {
  SILVER_ONLY
  SILVER_GOLD
  SILVER_DIAMONDS
  SILVER_STONES
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  phone          String?
  personalInfo   String?
  role           UserRole        @default(CUSTOMER)
  status         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  addresses      Address[]
  cart           Cart?
  wishlist       Wishlist[]
  orders         Order[]
  loyaltyAccount LoyaltyAccount?
  auditLogs      AdminAuditLog[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Material {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Theme {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Collection {
  id             String    @id @default(uuid())
  name           String    @unique
  nameGeo        String?
  nameEng        String?
  slug           String    @unique
  description    String?
  descriptionGeo String?
  descriptionEng String?
  imageUrl       String?
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id               String         @id @default(uuid())
  name             String
  nameGeo          String?
  nameEng          String?
  slug             String         @unique
  sku              String         @unique
  price            Float
  salePrice        Float?
  discount         Float?         @default(0)
  year             Int?
  materialId       String?
  material         Material?      @relation(fields: [materialId], references: [id])
  materialType     MaterialType?
  model            String?
  themeId          String?
  theme            Theme?         @relation(fields: [themeId], references: [id])
  brandId          String?
  brand            Brand?         @relation(fields: [brandId], references: [id])
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id])
  collectionId     String?
  collection       Collection?    @relation(fields: [collectionId], references: [id])
  description      String
  descriptionGeo  String?
  descriptionEng  String?
  shortDescription String?
  tags             String[]
  ageGroup         String?
  numberOfPieces   Int?
  weight           String?
  dimensions       String?
  featured         Boolean        @default(false)
  stock            Int            @default(0)
  available        Boolean        @default(true)
  status           ProductStatus  @default(PUBLISHED)
  images           ProductImage[]
  wishlistItems    Wishlist[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Address {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  fullName    String
  phone       String
  country     String      @default("Georgia")
  city        String
  postalCode  String?
  street      String
  apartment   String?
  addressType AddressType @default(HOME)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id                  String             @id @default(uuid())
  orderNumber         String             @unique @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  subtotal            Float
  discount            Float              @default(0)
  loyaltyPointsUsed   Int                @default(0)
  loyaltyPointsEarned Int                @default(0)
  deliveryMethod      DeliveryMethodType
  deliveryPrice       Float              @default(0)
  deliveryAddress     String?
  paymentMethod       String?
  paymentStatus       PaymentStatus      @default(PENDING)
  orderStatus         OrderStatus        @default(PENDING)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  payments            Payment[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
}

model Payment {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider @default(MOCK)
  amount        Float
  currency      String          @default("GEL")
  status        PaymentStatus   @default(PENDING)
  transactionId String?
  callbackData  Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model LoyaltyAccount {
  id            String               @id @default(uuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  points        Int                  @default(0)
  totalEarned   Int                  @default(0)
  totalRedeemed Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  transactions  LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String                 @id @default(uuid())
  accountId String
  account   LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points    Int
  type      LoyaltyTransactionType
  reason    String
  orderId   String?
  createdAt DateTime               @default(now())
}

model DeliveryMethod {
  id              String             @id @default(uuid())
  type            DeliveryMethodType @unique
  name            String
  price           Float
  active          Boolean            @default(true)
  zones           String[]           @default([])
  estimatedDays   String?
  pickupLocations String[]           @default([])
  schedule        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model BlogCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogPost {
  id             String        @id @default(uuid())
  title          String
  titleGeo       String?
  titleEng       String?
  slug           String        @unique
  excerpt        String?
  excerptGeo     String?
  excerptEng     String?
  content        String
  contentGeo     String?
  contentEng     String?
  featuredImage  String?
  author         String
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  tags           String[]      @default([])
  seoTitle       String?
  seoDescription String?
  published      Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model Coupon {
  id         String    @id @default(uuid())
  code       String    @unique
  discount   Float
  active     Boolean   @default(true)
  minAmount  Float?
  validUntil DateTime?
  createdAt  DateTime  @default(now())
}

model StoreSettings {
  id           String   @id @default(uuid())
  storeName    String   @default("Silver Boutique")
  email        String?
  phone        String?
  address      String?
  currency     String   @default("GEL")
  taxRate      Float    @default(0)
  logoUrl      String?
  socialMedia  Json?
  homepageHero Json?
  footer       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Policy {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  titleGeo    String?
  titleEng    String?
  content     String
  contentGeo  String?
  contentEng  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  details   Json?
  createdAt DateTime @default(now())
}
